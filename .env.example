# Latch (Next.js on port 3000)
USE_MOCKS=true

# OpenAI — used by the intent parser when set
OPENAI_API_KEY=your_openai_api_key_here

# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STORE_NAME=your-store-name
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
SHOPIFY_ADMIN_TOKEN=your_shopify_admin_token
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_PASSWORD=your_shopify_password
SHOPIFY_AGENT_PROFILE_URL=

# Rain scoped cards
RAIN_API_KEY=your_rain_api_key_here
RAIN_USER_ID=your_rain_user_id
RAIN_API_BASE_URL=https://api-dev.raincards.xyz/v1

# Optional standalone Express backend (npm run backend) — port 3001
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/escrow
