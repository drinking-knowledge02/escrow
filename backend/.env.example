# Server Configuration (3001 so it does not collide with Next.js on 3000)
PORT=3001

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Shopify Configuration
SHOPIFY_STORE_NAME=your-store-name
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_PASSWORD=your_shopify_password

# Rain API Configuration
RAIN_API_KEY=your_rain_api_key_here

# Database Configuration (optional, for production)
DATABASE_URL=postgresql://user:password@localhost:5432/escrow
